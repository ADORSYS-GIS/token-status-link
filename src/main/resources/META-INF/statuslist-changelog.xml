<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="create-status-list-mapping" author="adorsys">
        <createTable tableName="status_list_mapping">
            <column name="id" type="varchar(36)">
                <constraints nullable="false" primaryKey="true"
                             primaryKeyName="pk_status_list_mapping" />
            </column>
            <column name="idx" type="bigint">
                <constraints nullable="false" />
            </column>
            <column name="status_list_id" type="varchar(255)">
                <constraints nullable="false" />
            </column>
            <column name="user_id" type="varchar(255)" />
            <column name="token_id" type="varchar(255)" />
            <column name="realm_id" type="varchar(255)" />
            <column name="status" type="varchar(32)" />
        </createTable>

        <addUniqueConstraint tableName="status_list_mapping"
                             columnNames="idx,status_list_id"
                             constraintName="uk_status_list_mapping_idx_status_list_id" />
    </changeSet>

    <changeSet id="add-indices-to-status-list-mapping" author="adorsys">
        <createIndex indexName="idx_status_list_mapping_realm_user"
                     tableName="status_list_mapping">
            <column name="realm_id" />
            <column name="user_id" />
        </createIndex>

        <!-- This index handles lookups by status_list_id specifically.
             Important for pessimistic locking in getNextIndex() -->
        <createIndex indexName="idx_status_list_mapping_status_list_id"
                     tableName="status_list_mapping">
            <column name="status_list_id" />
        </createIndex>

        <!-- This index handles lookups by token_id specifically -->
        <createIndex indexName="idx_status_list_mapping_token_id"
                     tableName="status_list_mapping">
            <column name="token_id" />
        </createIndex>
    </changeSet>

    <changeSet id="add-created-timestamp-to-status-list-mapping" author="adorsys">
        <addColumn tableName="status_list_mapping">
            <column name="created_timestamp" type="bigint"/>
        </addColumn>
        <createIndex indexName="idx_status_list_mapping_realm_created_timestamp" tableName="status_list_mapping">
            <column name="realm_id" />
            <column name="created_timestamp" />
        </createIndex>
    </changeSet>

    <changeSet id="add-token-status-to-status-list-mapping" author="adorsys">
        <addColumn tableName="status_list_mapping">
            <column name="token_status" type="varchar(32)" defaultValue="VALID">
                <constraints nullable="false" />
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="add-credential-configuration-id-to-status-list-mapping" author="adorsys">
        <!--
          Existing rows remain NULL. Quota enforcement and limits metadata ignore those legacy
          rows (see README upgrade note); only post-migration issuances store a type and count.
        -->
        <addColumn tableName="status_list_mapping">
            <column name="credential_configuration_id" type="varchar(255)" />
        </addColumn>
        <createIndex indexName="idx_status_list_mapping_realm_user_type"
                     tableName="status_list_mapping">
            <column name="realm_id" />
            <column name="user_id" />
            <column name="credential_configuration_id" />
        </createIndex>
    </changeSet>

    <changeSet id="create-status-list-quota-lock" author="adorsys">
        <createTable tableName="status_list_quota_lock">
            <column name="realm_id" type="varchar(255)">
                <constraints nullable="false" />
            </column>
            <column name="user_id" type="varchar(255)">
                <constraints nullable="false" />
            </column>
            <column name="credential_configuration_id" type="varchar(255)">
                <constraints nullable="false" />
            </column>
        </createTable>
        <addPrimaryKey tableName="status_list_quota_lock"
                       columnNames="realm_id,user_id,credential_configuration_id"
                       constraintName="pk_status_list_quota_lock" />
    </changeSet>

</databaseChangeLog>
